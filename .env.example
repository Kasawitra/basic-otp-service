# Server configuration
PORT=8080

# Twilio credentials (from Twilio Console -> Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Verify Service SID (from Twilio Console -> Verify -> Services)
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: if true, immediately retry with channel=sms when Twilio returns an API error on channel=whatsapp
# (e.g., error 68008 if WhatsApp is not yet configured). Default is false so misconfigurations are visible.
FALLBACK_TO_SMS_ON_API_ERROR=false
